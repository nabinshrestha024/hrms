    "clean": "rm -rf dist node_modules/.vite apps/erp-shell/dist",
    "clean:all": "node scripts/clean.mjs",
    "reset": "node scripts/clean.mjs && pnpm install",
    "generate": "pnpm nx g @org/generators:route",
    "msw:init": "npx msw init apps/erp-shell/public --save"
